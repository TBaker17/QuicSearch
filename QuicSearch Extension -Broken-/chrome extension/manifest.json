{
  "manifest_version": 3,
  "name": "QuicSearch",
  "version": "1.0",
  "description": "A search extension for quick Google queries.",
  "permissions": [
    "tabs",
    "storage",
    "https://www.googleapis.com/*" 
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "logo.png",
      "48": "logo.png",
      "128": "logo.png"
    }
  },
  "icons": {
    "16": "logo.png",
    "48": "logo.png",
    "128": "logo.png"
  }
}






